# --- Server-side only. Never commit .env or expose these in frontend code. ---
# Groq (https://console.groq.com/keys). Leave empty => demo itineraries.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase (Project Settings > API). Leave empty => no auth / no cloud trips.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowed browser origins (no trailing slash)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex, e.g. to allow Vercel previews: https://.*\.vercel\.app
ALLOW_ORIGIN_REGEX=
